{
  "name": "stickygum",
  "version": "0.0.2",
  "description": "Sticky sidebar library with smooth scrolling and responsive support.",
  "homepage": "https://code-hemu.github.io/stickygum/",
  "bugs": {
    "url": "https://github.com/code-hemu/stickygum/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/code-hemu/stickygum.git"
  },
  "license": "GPL-3.0",
  "author": "Hemanta Gayen",
  "type": "module",
  "main": "dist/stickygum.cjs.js",
  "module": "dist/stickygum.esm.js",
  "browser": "dist/stickygum.min.js",
  "unpkg": "dist/stickygum.min.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/stickygum.esm.js",
      "require": "./dist/stickygum.cjs.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "clean": "guchho clean",
    "dev": "cd playground && guchho dev --open",
    "build": "guchho build",
    "playground:build": "cd playground && guchho build",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@guchho/banner": "^0.1.4",
    "@guchho/dts": "^0.2.0",
    "@typescript/typescript6": "^6.0.2",
    "guchho": "^1.0.8",
    "typescript": "^7.0.2"
  }
}
